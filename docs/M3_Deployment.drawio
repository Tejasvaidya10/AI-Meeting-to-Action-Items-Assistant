        <mxCell id="jira" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1A1A1A&#x27;&gt;Jira Cloud&lt;/font&gt;&lt;/b&gt;&lt;br&gt;10 s timeout, ≤ 3 attempts&lt;br&gt;idem- label for reconcile&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#6A6A6A&#x27;&gt;prototype: jira_sim.py&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=12;fontColor=#2B2B2B;verticalAlign=middle;fillColor=#DCEFDC;strokeColor=#4C9A5B;" vertex="1" parent="1"><mxGeometry x="1400" y="310" width="260" height="115" as="geometry"/></mxCell>
