        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="AI Meeting-to-Action-Items Assistant: Planned Production Deployment" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="200" y="10" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="zA" value="A · USERS &amp;amp; SOURCES" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;fillColor=#FFFBEF;strokeColor=#B8860B;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="10" y="60" width="250" height="560" as="geometry"/></mxCell>
        <mxCell id="zB" value="B · OUR CLOUD PROJECT (one region, planned)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;fillColor=#F7FAFE;strokeColor=#3F6FB0;fontColor=#3F6FB0;" vertex="1" parent="1"><mxGeometry x="285" y="60" width="1070" height="560" as="geometry"/></mxCell>
        <mxCell id="zC" value="C · EXTERNAL SAAS" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;fillColor=#F7F7F7;strokeColor=#555555;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1380" y="60" width="300" height="560" as="geometry"/></mxCell>
        <mxCell id="mp" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1A1A1A&#x27;&gt;Meeting Platform&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Sends transcript webhook" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=12;fontColor=#2B2B2B;verticalAlign=middle;fillColor=#FFF4CC;strokeColor=#C9A227;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="210" height="85" as="geometry"/></mxCell>
        <mxCell id="rv" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1A1A1A&#x27;&gt;Reviewer&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Organizer, then project lead&lt;br&gt;Browser, company SSO" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=12;fontColor=#2B2B2B;verticalAlign=middle;fillColor=#FFF4CC;strokeColor=#C9A227;" vertex="1" parent="1"><mxGeometry x="30" y="275" width="210" height="85" as="geometry"/></mxCell>
        <mxCell id="op" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1A1A1A&#x27;&gt;On-call Operator&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Paged on alerts" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=12;fontColor=#2B2B2B;verticalAlign=middle;fillColor=#FFF4CC;strokeColor=#C9A227;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="210" height="85" as="geometry"/></mxCell>
        <mxCell id="img" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1A1A1A&#x27;&gt;One container image, autoscaled 1–3 instances&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EBDDF2;strokeColor=#8E6BA8;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="100" width="620" height="300" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1A1A1A&#x27;&gt;Webhook API&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Verifies signature, records event&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#6A6A6A&#x27;&gt;prototype: cli.py emit&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=12;fontColor=#2B2B2B;verticalAlign=middle;fillColor=#EBDDF2;strokeColor=#8E6BA8;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1A1A1A&#x27;&gt;Review Web App&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Review packet, approve / reject / edit&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#6A6A6A&#x27;&gt;prototype: app.py (Streamlit)&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=12;fontColor=#2B2B2B;verticalAlign=middle;fillColor=#EBDDF2;strokeColor=#8E6BA8;" vertex="1" parent="1"><mxGeometry x="330" y="275" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="wk" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1A1A1A&#x27;&gt;Worker&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Event handler + inbox&lt;br&gt;Review checkpoint&lt;br&gt;Approval Guard&lt;br&gt;Outbox + reconciler&lt;br&gt;Extraction + validation&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#6A6A6A&#x27;&gt;prototype: controller.py&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=12;fontColor=#2B2B2B;verticalAlign=middle;fillColor=#F7F7F7;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="635" y="140" width="275" height="240" as="geometry"/></mxCell>
        <mxCell id="sch" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1A1A1A&#x27;&gt;Scheduler&lt;/font&gt;&lt;/b&gt;&lt;br&gt;timer.tick every 5 min&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#6A6A6A&#x27;&gt;prototype: cli.py tick&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=12;fontColor=#2B2B2B;verticalAlign=middle;fillColor=#F7F7F7;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="960" y="195" width="370" height="68" as="geometry"/></mxCell>
        <mxCell id="sec" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1A1A1A&#x27;&gt;Secret Manager&lt;/font&gt;&lt;/b&gt;&lt;br&gt;OpenAI key, Jira token; never in code or logs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=12;fontColor=#2B2B2B;verticalAlign=middle;fillColor=#FDECEA;strokeColor=#C0504D;" vertex="1" parent="1"><mxGeometry x="960" y="280" width="370" height="68" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1A1A1A&#x27;&gt;Managed PostgreSQL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;runs · reviews · actions (outbox) · inbox&lt;br&gt;Daily backups, point-in-time restore&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#6A6A6A&#x27;&gt;prototype: data/workflow.db (SQLite)&lt;/font&gt;&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=12;fontColor=#2B2B2B;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="445" width="580" height="150" as="geometry"/></mxCell>
        <mxCell id="log" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1A1A1A&#x27;&gt;Logs, Metrics, Alerts&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Audit events per step, run snapshots&lt;br&gt;Spend, failure rate, stuck reviews&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#6A6A6A&#x27;&gt;prototype: logs/audit.jsonl&lt;/font&gt;&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=12;fontColor=#2B2B2B;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="445" width="370" height="150" as="geometry"/></mxCell>
